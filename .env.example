# Default: attempt JTO/SKT only when endpoint details are supplied; otherwise use ESTIMATED LIVE.
DATA_MODE=auto
INGEST_TOKEN=replace-with-a-long-random-secret

# Add only after JTO/SKT grants an approved endpoint and credential.
JTO_SKT_API_URL=https://approved-jto-skt-endpoint.example
JTO_SKT_API_TOKEN=replace-with-provider-secret
JTO_SKT_POLL_MS=300000
JTO_SKT_AUTH_HEADER=Authorization
JTO_SKT_AUTH_SCHEME=Bearer

# Use these only if the upstream JSON does not use one of the documented default field names.
# JTO_SKT_TOTAL_PATH=data.people.total
# JTO_SKT_LOCALS_PATH=data.people.locals
# JTO_SKT_TOURISTS_PATH=data.people.tourists
# JTO_SKT_OBSERVED_AT_PATH=data.observedAt

# Optional: JTO public chart adapter, patterned after the mondak collector.
# Set only after confirming that this one chart is publicly accessible and permitted for this use.
# It produces JTO_PUBLIC_CHART_DERIVED, never SKT/JTO realtime.
# JTO_PUBLIC_CHART_REG_SN=<approved numeric dataset id>
# JTO_PUBLIC_CHART_INDEX=0
# JTO_PUBLIC_CHART_VALUE_PATH=data.charts.0.data.0.<approved numeric field>
# JTO_PUBLIC_CHART_LOCALS_PATH=data.charts.0.data.0.<approved local field>
# JTO_PUBLIC_CHART_TOURISTS_PATH=data.charts.0.data.0.<approved tourist field>
# JTO_PUBLIC_CHART_OBSERVED_AT_PATH=data.dataBgnDt
